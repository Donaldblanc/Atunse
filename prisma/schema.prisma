// The data model mirrors the admin screens (scratch/*.jpeg design images):
// Orders and Order detail, Calendar (Appointment), Customers (Account,
// Note), Services & Pricing (Service, Bundle), Inventory (InventoryItem,
// Supplier, StockMovement), Payments (Payment), Messages (Conversation,
// Message), Reviews (Review), Settings (BusinessSettings, OperatingHours)
// and the top bar's bell (Notification).
// An Order still has no status of its own: screens derive it from its
// Items (CONTEXT.md: Order Status). Stripe and the notification outbox
// come later (docs/SPEC.md Build sequence).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ItemStatus {
  REQUEST_SUBMITTED
  UNDER_REVIEW
  QUOTE_SENT
  APPROVED
  AWAITING_SNEAKERS
  IN_PROGRESS
  QUALITY_CHECK
  READY_FOR_PICKUP_SHIPPING
  COMPLETED
  CANCELLED
}

// CONTEXT.md: exactly two ways sneakers reach the shop. There is no drop-off.
enum FulfillmentMethod {
  PICKUP
  MAIL_IN
}

// CONTEXT.md: Payment. The Deposit comes first; the Balance is the rest.
// FULL is one payment covering the whole Order, which the owner can record
// instead (e.g. a customer who pays everything in cash at collection).
enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
}

// Zelle and Cash are confirmed by hand (ADR-0002); CARD is Stripe, behind
// its feature toggle, and confirms itself.
enum PaymentMethod {
  ZELLE
  CASH
  CARD
  APPLE_PAY
}

// FAILED: a card/Apple Pay charge that didn't go through. REFUNDED: money
// that was received and has been given back (receivedAt stays set).
enum PaymentStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
}

// CONTEXT.md: Appointment. COLLECTION is DJ collecting a Local Drop-Off
// pair from the customer; RETURN is dropping it back off.
enum AppointmentKind {
  COLLECTION
  RETURN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Services & Pricing's categories (Categories tab). Add-ons are ADDITIONAL.
enum ServiceCategory {
  CLEANING
  RESTORATION
  CUSTOM_WORK
  ADDITIONAL
}

// Why an Inventory Item's stock changed (Stock History).
enum StockMovementReason {
  RESTOCK
  USED
  ADJUSTMENT
}

enum MessageChannel {
  IN_APP
  EMAIL
  SMS
}

// Reviews screen: new reviews wait for moderation; HIDDEN is unpublished.
enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

// What the top bar's bell announces.
enum NotificationKind {
  NEW_BOOKING
  CUSTOMER_MESSAGE
  PAYMENT_RECEIVED
  LOW_STOCK
  NEW_REVIEW
}

enum MessageAuthor {
  CUSTOMER
  ADMIN
}

// A Customer or Admin (ADR-0014). The two are separate identities: an
// admin who books gets a Customer Account under the same email, and Orders
// only ever belong to Customer Accounts. A Customer Account is created
// automatically by their first booking; there are no guest orders.
model Account {
  id    String  @id @default(cuid())
  role  Role    @default(CUSTOMER)
  email String // always stored lowercased; unique per role, below
  // What the admin screens call the customer (Customers, Order detail).
  // Set from the first booking's contact name; each Order keeps its own
  // contactName as entered.
  name  String?
  // Required for Customer Accounts (the booking that creates one requires
  // it); null only for Admin Accounts seeded without one.
  phone String?

  // Interim admin password login (ADR-0005 addendum). Customers sign in
  // with an emailed code instead (SignInCode), so this stays null for them.
  passwordHash String?

  createdAt DateTime @default(now())

  orders        Order[]
  signInCodes   SignInCode[]
  conversations Conversation[]
  // Notes the shop keeps about this customer (Customers, Order detail).
  notes         Note[]
  reviews       Review[]

  @@unique([email, role])
  @@map("accounts")
}

// The billing/shipping container (CONTEXT.md: Order). No status of its own —
// display is always a per-Item breakdown.
model Order {
  id        String  @id @default(cuid())
  // The number the admin screens show, "ATU-1008" (orderNumber() in
  // domain.ts). Sequential from 1001. Customers still quote
  // orderReference() in their Zelle memo.
  number    Int     @unique @default(autoincrement())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  // Contact details as entered for this booking. The owning Account is
  // accountId; these are a per-Order snapshot for the shop to reach out.
  contactName  String
  contactEmail String
  contactPhone String

  policyAcceptedAt DateTime // Policy Acceptance is captured at submission, not deferred (ADR revision)

  // ADR-0015: which Terms of Service & Restoration Agreement the customer
  // accepted at policyAcceptedAt: its version, permanent URL and the
  // SHA-256 of the PDF, plus each risk acknowledgment's id -> ticked. Null
  // for Orders from before the agreement existed.
  termsVersion         String?
  termsUrl             String?
  termsSha256          String?
  termsAcknowledgments Json?

  // Where the sneakers come from: the Pickup address (NY/NJ/CT) or the
  // Mail-In customer's shipping address (ADR-0010: captured, not labelled).
  fulfillmentMethod FulfillmentMethod
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  zip               String
  pickupDate        DateTime?         @db.Date // Pickup only
  pickupSlot        String? // Pickup only, e.g. "4:30 PM – 5:00 PM"
  mailInDate        DateTime?         @db.Date // Mail-In only, optional preferred date

  rush Boolean @default(false)

  // Server-computed from the service catalog, never from client-sent
  // prices. Money as integer cents (ADR-0012).
  estimateCents     Int
  estimateIsMinimum Boolean // true when a "from $X+" Service is included
  depositCents      Int // 50% of estimateCents, rounded down (CONTEXT.md: Deposit)

  // Order detail's totals, set by the owner (Money as integer cents). Not
  // computed at booking yet: whether and when tax and a Local Drop-Off fee
  // apply is an open question (CONTEXT.md).
  dropOffFeeCents Int @default(0)
  taxCents        Int @default(0)

  // The Bundle bought, or null for a single pair. Its perks that cover
  // only some pairs are assigned by the shop after inspection, so the
  // Order has to say which Bundle it was.
  bundleId String?
  // Restrict: Bundles are deactivated, never deleted, since Orders name them.
  bundle   Bundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  // Client-generated key for retry-safe submission (ADR-0012): a resubmit
  // with the same key returns the existing Order instead of a duplicate.
  submissionKey         String? @unique
  // Hash of what was submitted with that key (#76): a retry with the same
  // key but different details is refused instead of returning this Order
  // as if nothing changed. Null for Orders from before it existed.
  submissionFingerprint String?

  // Set once the booking confirmation email has actually gone out. A retry
  // of the same submission sends it while this is still null, so a failed
  // send (e.g. a provider outage) isn't lost for good.
  confirmationEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When the shop last asked the customer for a Review (Request Review).
  reviewRequestedAt DateTime?

  items         Item[]
  payments      Payment[]
  appointments  Appointment[]
  conversations Conversation[]
  notes         Note[]
  review        Review?
  notifications Notification[]
  stockUsed     StockMovement[]

  @@index([createdAt]) // the admin Overview's date ranges and Recent Orders
  @@map("orders")
}

// One sneaker pair (CONTEXT.md: Item = one pair, not one shoe). Carries its
// own status through the pipeline, independent of sibling Items.
model Item {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  brand       String?
  model       String?
  description String?
  material    String?
  size        String? // e.g. "10", "W 8.5": entered by the owner on Order detail
  colorway    String? // e.g. "Black / White"
  condition   String? // the owner's assessment on Order detail, e.g. "Good"

  // The pair's place in its Order (0 for a single pair; 0-2 in a Bundle),
  // so pairs always read back in the order the customer entered them.
  position Int @default(0)

  serviceIds    String[] // Service ids (services table)
  estimateCents Int // this pair's share of the Order estimate, before Rush

  status ItemStatus @default(REQUEST_SUBMITTED)

  // Money as integer cents (ADR-0012) — never a float.
  priceCents Int?

  photos ItemPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntries ItemAuditEntry[]

  @@map("items")
}

// One condition photo on an Item: a storage key from the FileStorage
// adapter (ADR-0004), not a URL.
// - `key` is where the photo lives: a copy made when the booking was
//   submitted, which no upload target can write to, so the verified bytes
//   can't be swapped afterwards (#77).
// - `uploadKey` is the key the browser uploaded to. It's unique, so an
//   upload belongs to exactly one Item, and quoting another booking's key
//   can never grant view access to it (ADR-0014).
// Orders from before #77 have key = uploadKey.
model ItemPhoto {
  id        String @id @default(cuid())
  itemId    String
  item      Item   @relation(fields: [itemId], references: [id])
  key       String @unique
  uploadKey String @unique
  position  Int

  @@index([itemId])
  @@map("item_photos")
}

// Every state-changing action on an Item is recorded (ADR-0012: auditability
// as a domain concern, not an afterthought).
model ItemAuditEntry {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  action         String // e.g. "STATUS_TRANSITION", "QUOTE_SENT", "MANUAL_PAYMENT_CONFIRMED"
  fromStatus     ItemStatus?
  toStatus       ItemStatus?
  actorAccountId String? // who did it; null for system actions
  idempotencyKey String? // set on actions that must be retry-safe (e.g. payment confirmation)
  metadata       Json?

  createdAt DateTime @default(now())

  @@unique([itemId, idempotencyKey])
  @@map("item_audit_entries")
}

// One-time email sign-in code (ADR-0014). Only an HMAC of the code is
// stored. A code is single-use, expires after a few minutes, and is locked
// after too many wrong guesses.
model SignInCode {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId, createdAt])
  @@map("sign_in_codes")
}

// Fixed-window request counters for per-IP rate limits on the public
// routes (#77). `key` is "<policy>:<HMAC of the client IP>": raw IPs are
// never stored. Old windows are pruned as new ones are written.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

// One payment an Order is owed or has received (Payments screen, Order
// detail). Booking creates the Deposit as PENDING; the owner marks Zelle
// and Cash payments RECEIVED by hand (ADR-0002), retry-safe on
// idempotencyKey (ADR-0012).
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  kind        PaymentKind
  method      PaymentMethod
  amountCents Int // Money as integer cents (ADR-0012); always > 0
  status      PaymentStatus @default(PENDING)

  receivedAt           DateTime? // set for RECEIVED and REFUNDED
  confirmedByAccountId String? // the admin who marked it received; null for automatic (CARD, APPLE_PAY)
  idempotencyKey       String?
  // The processor's charge id (e.g. "ch_3N8f...") or a Zelle confirmation
  // number; null for Cash or when none was noted ("Manual").
  reference            String?
  failureReason        String? // FAILED only
  refundedAt           DateTime? // REFUNDED only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@index([status, kind])
  @@map("payments")
}

// A booked time on the Calendar: DJ collecting a Local Drop-Off pair, or
// dropping it back off. At most one of each per Order; rescheduling moves
// it. The Order's pickupDate/pickupSlot stay as the customer booked them.
model Appointment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  kind                AppointmentKind
  status              AppointmentStatus @default(SCHEDULED)
  startsAt            DateTime
  endsAt              DateTime
  notes               String?
  // The Admin Account doing it (Calendar's staff filter); null = unassigned.
  assignedToAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, kind])
  @@index([startsAt])
  @@map("appointments")
}

// CONTEXT.md: Service (Services & Pricing). The id is the stable slug
// Items store in serviceIds, e.g. "premium". Prices are Money as integer
// cents; a "from $25+" Service has isMinimum. Deactivating hides a Service
// from new bookings; it is never deleted, since past Items name it.
model Service {
  id             String          @id
  name           String
  description    String
  category       ServiceCategory
  isCleaningTier Boolean // Standard and Premium Clean: at most one per Item
  isAddOn        Boolean // CONTEXT.md: Add-on
  baseCents      Int
  isMinimum      Boolean
  suedeFeeCents  Int             @default(0) // the Suede Fee on suede pairs; 0 = none
  minimumLabel   String? // what a minimum price covers, e.g. "Midsole"
  alsoFrom       Json? // other published "from" prices: [{ label, cents }]
  internalNotes  String? // admin only, never shown to customers
  active         Boolean         @default(true)
  position       Int // display order

  images ServiceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

// CONTEXT.md: Bundle (Services & Pricing, Bundles tab).
model Bundle {
  id            String   @id // stable slug, e.g. "revival"
  name          String
  priceCents    Int
  perks         String[]
  internalNotes String?
  active        Boolean  @default(true)
  position      Int

  orders Order[]
  images BundleImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bundles")
}

// Where the shop restocks supplies (Inventory, Suppliers tab).
model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  website String?
  notes   String?

  items InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

// A supply, material or care product the shop keeps on hand (Inventory).
// "Low Stock" is stock <= lowStockAt, derived, never stored.
model InventoryItem {
  id                String    @id @default(cuid())
  name              String
  description       String?
  sku               String?   @unique // e.g. "ATU-CP-001"
  brand             String?
  category          String // e.g. "Cleaning", "Laces", "Restoration", "Supplies"
  stock             Int       @default(0) // never negative; every change is a StockMovement
  lowStockAt        Int       @default(0)
  unitCostCents     Int?
  sellingPriceCents Int? // only for items the shop also sells
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  active            Boolean   @default(true)

  images    InventoryImage[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("inventory_items")
}

// The message thread between the shop and a customer about one Order
// (Messages). Archiving hides it from the inbox without deleting it.
model Conversation {
  id        String  @id @default(cuid())
  // The customer it's with. A Conversation can start before any booking
  // ("Do you offer pickup in Queens?"), so the Order is optional.
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id])
  subject   String? // e.g. "Pickup time confirmation"

  archivedAt    DateTime?
  lastMessageAt DateTime? // for sorting the inbox

  messages Message[]

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([orderId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// One message in a Conversation. "Unread" in the admin inbox is a
// CUSTOMER message with readAt null.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  author          MessageAuthor
  authorAccountId String? // the Account that wrote it
  channel         MessageChannel @default(IN_APP)
  body            String
  readAt          DateTime? // when the other side read it

  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Photos and files, each a FileStorage key (ADR-0004), in display order.
model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  key       String  @unique
  position  Int

  @@index([serviceId])
  @@map("service_images")
}

model BundleImage {
  id       String @id @default(cuid())
  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id])
  key      String @unique
  position Int

  @@index([bundleId])
  @@map("bundle_images")
}

model InventoryImage {
  id       String        @id @default(cuid())
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id])
  key      String        @unique
  position Int

  @@index([itemId])
  @@map("inventory_images")
}

// One change to an Inventory Item's stock (Stock History). The item's
// stock column is kept equal to the sum of its movements by the use-case
// that writes both in one transaction.
model StockMovement {
  id             String              @id @default(cuid())
  itemId         String
  item           InventoryItem       @relation(fields: [itemId], references: [id])
  change         Int // + restocked, - used; never 0
  reason         StockMovementReason
  note           String?
  orderId        String? // the Order it was used on, if any
  order          Order?              @relation(fields: [orderId], references: [id])
  actorAccountId String?

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@map("stock_movements")
}

model MessageAttachment {
  id          String  @id @default(cuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id])
  key         String  @unique // FileStorage key (ADR-0004)
  filename    String
  contentType String

  @@index([messageId])
  @@map("message_attachments")
}

// A note the shop keeps about a customer, optionally about one of their
// Orders (Customers' Notes tab, Order detail's Notes). Admin only.
model Note {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])
  orderId         String?
  order           Order?  @relation(fields: [orderId], references: [id])
  authorAccountId String?
  body            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([orderId])
  @@map("notes")
}

// A customer's review (Reviews). At most one per Order; "Verified
// Customer" means it's tied to one of their Orders. New reviews wait in
// PENDING until the owner publishes them on the website.
model Review {
  id        String       @id @default(cuid())
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  orderId   String?      @unique
  order     Order?       @relation(fields: [orderId], references: [id])
  rating    Int // 1-5
  body      String
  status    ReviewStatus @default(PENDING)

  publishedAt        DateTime?
  reply              String? // the shop's public reply
  repliedAt          DateTime?
  repliedByAccountId String?

  photos ReviewPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id])
  key      String @unique // FileStorage key (ADR-0004)
  position Int

  @@index([reviewId])
  @@map("review_photos")
}

// The top bar's bell. recipientAccountId null = every admin.
model Notification {
  id                 String           @id @default(cuid())
  recipientAccountId String?
  kind               NotificationKind
  title              String
  body               String?
  orderId            String?
  order              Order?           @relation(fields: [orderId], references: [id])
  readAt             DateTime?

  createdAt DateTime @default(now())

  @@index([recipientAccountId, readAt, createdAt])
  @@map("notifications")
}

// Settings > Business Profile: the one row of business details the site,
// booking flow and emails use. id is always 1.
model BusinessSettings {
  id           Int     @id @default(1)
  businessName String
  tagline      String?
  ownerName    String?
  email        String?
  phone        String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?
  timeZone     String // IANA, e.g. "America/New_York"
  currency     String // ISO 4217, e.g. "USD"
  logoKey      String? // FileStorage key (ADR-0004)

  // Booking Settings: which Fulfillment Methods customers can book.
  allowLocalDropOff Boolean @default(true)
  allowMailIn       Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("business_settings")
}

// Settings > Operating Hours: when Local Drop-Off collections can be
// booked, per weekday (0 = Sunday ... 6 = Saturday), in minutes past
// midnight, shop time.
model OperatingHours {
  weekday  Int     @id
  isOpen   Boolean
  opensAt  Int // e.g. 480 = 8:00 AM
  closesAt Int // e.g. 1320 = 10:00 PM

  @@map("operating_hours")
}
