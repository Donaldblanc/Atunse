# Postgres (ADR-0007/0008 — Neon in production, local Docker Postgres in dev)
DATABASE_URL=postgresql://atunse:atunse@localhost:5432/atunse_dev

# Auth provider (ADR-0005) — placeholders until a specific provider is chosen
AUTH_PROVIDER_PUBLIC_KEY=
AUTH_PROVIDER_SECRET_KEY=

# Interim credential auth (ADR-0005 addendum) — used until a managed provider
# is wired in. SESSION_SECRET signs the admin session cookie; generate with
# `openssl rand -hex 32`. ADMIN_EMAIL/ADMIN_PASSWORD are only read by
# `npm run prisma:seed` to bootstrap the first admin account.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Storage (ADR-0004) — S3 for presigned uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public asset base URL (e.g. an S3 bucket's public URL or a CloudFront
# domain in front of it) for marketing images like the landing page gallery
# (src/features/landing/gallery.ts). Unset in dev — falls back to the
# committed placeholder photos in public/images/landing/.
NEXT_PUBLIC_ASSETS_BASE_URL=

# Notifications (ADR-0006) — Resend; unset in Phase 1, ConsoleNotificationService is used instead
RESEND_API_KEY=

# Feature toggles (ADR TODOs — env/config only, not owner-facing UI)
FEATURE_STRIPE_ENABLED=false
FEATURE_SMS_ENABLED=false
