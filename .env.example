# Postgres (ADR-0007/0008 — Neon in production, local Docker Postgres in dev)
DATABASE_URL=postgresql://atunse:atunse@localhost:5432/atunse_dev
# Integration tests delete data, so they use only this database, never
# DATABASE_URL. Its name must end in _test (src/shared/testing/test-env.ts).
TEST_DATABASE_URL=postgresql://atunse:atunse@localhost:5432/atunse_test

# Auth provider (ADR-0005) — placeholders until a specific provider is chosen
AUTH_PROVIDER_PUBLIC_KEY=
AUTH_PROVIDER_SECRET_KEY=

# Interim credential auth (ADR-0005 addendum) — used until a managed provider
# is wired in. SESSION_SECRET signs the admin and customer session cookies,
# and each other use (sign-in codes, rate-limit hashes, local upload links)
# gets its own key derived from it. At least 32 characters; generate with
# `openssl rand -hex 32`. ADMIN_EMAIL/ADMIN_PASSWORD are only read by
# `npm run prisma:seed` to bootstrap the first admin account.
# Changing it (or the session cookie names) signs every admin and customer out.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Storage (ADR-0004) — booking photos. STORAGE_DRIVER=local (default outside
# production) writes to .uploads/ through a dev-only route; s3 (default in
# production) needs the bucket vars below. Production refuses `local`.
# S3_* names win; Neon storage's AWS_* names (AWS_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3) work as-is. Setting an endpoint
# (S3-compatible provider like Neon) switches to path-style bucket URLs.
STORAGE_DRIVER=
# Origins allowed to upload to the bucket, for `npm run storage:configure`
# only (not read by the app), e.g. https://atunse.com,https://*.vercel.app
STORAGE_ALLOWED_ORIGINS=
# The database that goes with the bucket, for `npm run storage:cleanup` only.
# Deliberately not DATABASE_URL: pairing the wrong database with a bucket
# would make every photo look unreferenced. Best set on the command line.
STORAGE_CLEANUP_DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public asset base URL (e.g. an S3 bucket's public URL or a CloudFront
# domain in front of it) for marketing images like the landing page gallery
# (src/features/landing/gallery.ts). Unset in dev — falls back to the
# committed placeholder photos in public/images/landing/.
NEXT_PUBLIC_ASSETS_BASE_URL=

# Deposit payment instructions shown after booking and in the confirmation
# email (ADR-0002: Zelle confirmed manually by the owner). When either is
# unset, customers are told instructions will follow by email.
ZELLE_RECIPIENT=
ZELLE_NAME=

# Notifications (ADR-0006) — Resend is used when both are set; otherwise emails
# (including sign-in codes) are only logged by ConsoleNotificationService.
# EMAIL_FROM must be a sender on a domain verified in Resend, and a MONITORED
# mailbox: customers who reply to a booking confirmation reach it.
RESEND_API_KEY=
EMAIL_FROM=
# The shop's inbox, and a launch requirement. Used for: the /contact form
# (replies go straight to the customer via Reply-To), new-booking alerts to
# the owner, and the "Need to cancel your booking or close your account?
# Email us at ..." line on the booking Review/Confirmation steps and in the
# confirmation email. Unset in development, messages are only logged; unset
# in production, the form reports it's unavailable and booking points
# customers to it anyway, so set this before launch.
CONTACT_EMAIL=

# Feature toggles (ADR TODOs — env/config only, not owner-facing UI)
FEATURE_STRIPE_ENABLED=false
FEATURE_SMS_ENABLED=false
# Customer email-code login (ADR-0014). Off: a booking with an existing email
# attaches to that account and customers can't sign in or view photos. Turn
# on only once RESEND_API_KEY/EMAIL_FROM are set, or codes can't be delivered.
FEATURE_CUSTOMER_SIGN_IN_ENABLED=false

# DMCA Designated Agent (17 U.S.C. 512(c)), shown on /copyright. Register the
# agent at copyright.gov first. /copyright and the footer "Copyright" link
# appear only when NAME, ADDRESS and EMAIL are all set.
DMCA_AGENT_NAME=
# Full postal address; write line breaks as \n
DMCA_AGENT_ADDRESS=
DMCA_AGENT_EMAIL=
# Optional
DMCA_AGENT_PHONE=
DMCA_REGISTRATION_NUMBER=

# =============================================================================
# Vercel reference (NOT read from this file). Set these in Vercel → Settings →
# Environment Variables; each block can be pasted there after uncommenting and
# replacing every <…>. Use different secrets per environment, tick
# "Sensitive" on DATABASE_URL, SESSION_SECRET, S3_SECRET_ACCESS_KEY and
# RESEND_API_KEY, and redeploy after changes (Vercel applies them on the next
# deploy). docs/DEPLOYMENT.md has the full table.
#
# Don't set in Vercel: ADMIN_EMAIL/ADMIN_PASSWORD (one-time local seed),
# TEST_DATABASE_URL (local/CI), STORAGE_DRIVER (defaults to s3 there),
# STORAGE_ALLOWED_ORIGINS/STORAGE_CLEANUP_DATABASE_URL (scripts only).
# =============================================================================

# --- Production --------------------------------------------------------------
# DATABASE_URL=postgresql://<user>:<password>@<prod-host>.neon.tech/<db>?sslmode=require
# SESSION_SECRET=<64-hex-chars: openssl rand -hex 32>
# S3_BUCKET=atunse-images
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<access-key-id>
# S3_SECRET_ACCESS_KEY=<secret-access-key>
# S3_ENDPOINT=<only for S3-compatible storage, e.g. Neon>
# RESEND_API_KEY=re_<your-resend-key>
# EMAIL_FROM=Atunṣe <bookings@atunse.com>
# CONTACT_EMAIL=hello@atunse.com
# ZELLE_RECIPIENT=<zelle-email-or-phone>
# ZELLE_NAME=<name shown in Zelle>
# DMCA_AGENT_NAME=<agent full name, after registering at copyright.gov>
# DMCA_AGENT_ADDRESS=<Street>\n<City, ST ZIP>
# DMCA_AGENT_EMAIL=dmca@atunse.com
# DMCA_AGENT_PHONE=<optional>
# DMCA_REGISTRATION_NUMBER=<DMCA-1234567>
# NEXT_PUBLIC_ASSETS_BASE_URL=https://<bucket-or-cdn-public-url>
# FEATURE_CUSTOMER_SIGN_IN_ENABLED=false
# FEATURE_STRIPE_ENABLED=false
# FEATURE_SMS_ENABLED=false

# --- Preview (same keys as Production, except) -------------------------------
# Its own database: every build runs `prisma migrate deploy`, so a preview
# pointed at production would migrate it with unmerged PRs' migrations.
# DATABASE_URL=postgresql://<user>:<password>@<preview-host>.neon.tech/<preview-db>?sslmode=require
# SESSION_SECRET=<a-different-64-hex-chars>
# S3_BUCKET=atunse-images-preview
# S3_ACCESS_KEY_ID=<preview-access-key-id>
# S3_SECRET_ACCESS_KEY=<preview-secret-access-key>
# RESEND_API_KEY=re_<test-key>          (or leave both email keys unset: emails are only logged)
# EMAIL_FROM=Atunṣe Preview <preview@atunse.com>
# CONTACT_EMAIL=<your-own-inbox-for-testing>
# ZELLE_RECIPIENT=<test value>
# ZELLE_NAME=<test value>
