# Postgres (ADR-0007/0008 — Neon in production, local Docker Postgres in dev)
DATABASE_URL=postgresql://atunse:atunse@localhost:5432/atunse_dev

# Auth provider (ADR-0005) — placeholders until a specific provider is chosen
AUTH_PROVIDER_PUBLIC_KEY=
AUTH_PROVIDER_SECRET_KEY=

# Interim credential auth (ADR-0005 addendum) — used until a managed provider
# is wired in. SESSION_SECRET signs the admin session cookie; generate with
# `openssl rand -hex 32`. ADMIN_EMAIL/ADMIN_PASSWORD are only read by
# `npm run prisma:seed` to bootstrap the first admin account.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Storage (ADR-0004) — booking photos. STORAGE_DRIVER=local (default outside
# production) writes to .uploads/ through a dev-only route; s3 (default in
# production) needs the bucket vars below. Production refuses `local`.
# S3_* names win; Neon storage's AWS_* names (AWS_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3) work as-is. Setting an endpoint
# (S3-compatible provider like Neon) switches to path-style bucket URLs.
STORAGE_DRIVER=
# Origins allowed to upload to the bucket, for `npm run storage:configure`
# only (not read by the app), e.g. https://atunse.com,https://*.vercel.app
STORAGE_ALLOWED_ORIGINS=
# The database that goes with the bucket, for `npm run storage:cleanup` only.
# Deliberately not DATABASE_URL: pairing the wrong database with a bucket
# would make every photo look unreferenced. Best set on the command line.
STORAGE_CLEANUP_DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public asset base URL (e.g. an S3 bucket's public URL or a CloudFront
# domain in front of it) for marketing images like the landing page gallery
# (src/features/landing/gallery.ts). Unset in dev — falls back to the
# committed placeholder photos in public/images/landing/.
NEXT_PUBLIC_ASSETS_BASE_URL=

# Deposit payment instructions shown after booking and in the confirmation
# email (ADR-0002: Zelle confirmed manually by the owner). When either is
# unset, customers are told instructions will follow by email.
ZELLE_RECIPIENT=
ZELLE_NAME=

# Notifications (ADR-0006) — Resend is used when both are set; otherwise emails
# (including sign-in codes) are only logged by ConsoleNotificationService.
# EMAIL_FROM must be a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Feature toggles (ADR TODOs — env/config only, not owner-facing UI)
FEATURE_STRIPE_ENABLED=false
FEATURE_SMS_ENABLED=false
# Customer email-code login (ADR-0014). Off: a booking with an existing email
# attaches to that account and customers can't sign in or view photos. Turn
# on only once RESEND_API_KEY/EMAIL_FROM are set, or codes can't be delivered.
FEATURE_CUSTOMER_SIGN_IN_ENABLED=false
